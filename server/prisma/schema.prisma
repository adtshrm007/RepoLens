// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  CUSTOM
  GOOGLE
  GITHUB
}

model User {
  id String @id @default(cuid())

  name     String
  email    String  @unique
  username String?

  password String?

  provider AuthProvider @default(CUSTOM)

  profilePic String?

  githubId String? @unique
  googleId String? @unique

  githubAccessToken  String?
  githubRefreshToken String?

  appRefreshToken String?

  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repositories Repository[]
  fileDocs     FileDocumentation[]
}

model Repository {
  id String @id @default(cuid())

  name         String
  fullName     String
  githubRepoId String
  repoUrl      String
  isPrivate    Boolean
  language     String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  scans RepositoryScan[]
}

model RepositoryScan {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id])

  status        String   // "SCANNING", "ANALYZING", "COMPLETED", "FAILED"
  totalFiles    Int      @default(0)
  analyzedFiles Int      @default(0)
  
  summary       String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files            RepositoryFile[]
  securityFindings SecurityFinding[]
  findings         Finding[]
  healthScore      HealthScore?
  architecture     ArchitectureModel?
  onboardingGuide  OnboardingGuide?
  dependencyGraph  DependencyGraph?
}

model RepositoryFile {
  id String @id @default(cuid())

  scanId String
  scan   RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  path            String
  extension       String
  size            Int
  isAnalyzed      Boolean @default(false)
  importanceScore Int?

  classification FileClassification?
  metrics        FileMetrics?
}

model FileClassification {
  id String @id @default(cuid())
  
  fileId String @unique
  file   RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  type String // "Context Provider", "Component", "Service", "Route", etc.
}

model FileMetrics {
  id String @id @default(cuid())
  
  fileId String @unique
  file   RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  linesOfCode          Int
  functionCount        Int
  componentCount       Int
  hookUsage            Int
  avgFunctionLength    Float
  largestFunction      Int
  nestingDepth         Int
  dependencyCount      Int
  deadCodeIndicators   Int   @default(0)

  // Tree-sitter complexity metrics
  cyclomaticComplexity Float @default(0)
  cognitiveComplexity  Float @default(0)
  duplicateCodeBlocks  Int   @default(0)
  contentHash          String?
}

model SecurityFinding {
  id String @id @default(cuid())

  scanId String
  scan   RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  type        String
  severity    String // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  file        String
  lineNumber  Int
  snippet     String
  description String
  recommendation String?

  cwe         Json?
  cve         String?
  cvss        Float?
}

model DependencyGraph {
  id String @id @default(cuid())

  scanId String @unique
  scan   RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  nodes    Json
  edges    Json
  cycles   Json?    // circular dependency cycles detected by DependencyAnalyzer
  hotspots Json?    // top 5 highest fan-in files
  metrics  Json?    // { totalNodes, totalEdges, circularCount, maxFanIn, maxFanOut }
}

model HealthScore {
  id String @id @default(cuid())

  scanId String @unique
  scan   RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  maintainability Int
  security        Int
  architecture    Int
  documentation   Int
  overall         Int

  // Standalone security score (0-100) — separate from the health security subscore
  // Computed by SecurityScoringEngine with full deduction breakdown
  securityScore     Int?  @default(100)
  securityGrade     String? @default("A")
  securityBreakdown Json? // { deductions: [...], breakdown: {...} }
}

model ArchitectureModel {
  id String @id @default(cuid())

  scanId String @unique
  scan   RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  frontendLayer String?
  apiLayer      String?
  serviceLayer  String?
  dataLayer     String?
  authLayer     String?
  
  summary       String?
}

model OnboardingGuide {
  id String @id @default(cuid())

  scanId String @unique
  scan   RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  content     String
  entryPoints Json
  moduleFlow  Json
}

model FileDocumentation {
  id String @id @default(cuid())

  repoFullName String
  filePath     String

  purpose      String?
  architecture String?
  source       String  @default("analysis")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, repoFullName, filePath])
}

// RuleEngine output — one record per finding per scan
// Categories: SECURITY | DEPENDENCY | COMPLEXITY | CODE_QUALITY | ARCHITECTURE
// Severity (SECURITY/DEPENDENCY): CRITICAL | HIGH | MEDIUM | LOW
// Severity (COMPLEXITY):          VERY_HIGH | HIGH | MODERATE | LOW
// Severity (CODE_QUALITY/ARCHITECTURE): HIGH | MEDIUM | LOW
model Finding {
  id String @id @default(cuid())

  scanId String
  scan   RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  ruleId         String
  severity       String  // category-scoped severity label
  category       String  // "SECURITY" | "DEPENDENCY" | "COMPLEXITY" | "CODE_QUALITY" | "ARCHITECTURE"
  confidence     String  @default("HIGH") // "HIGH" | "MEDIUM" | "LOW"
  file           String
  line           Int     // alias for startLine — kept for backward compat
  startLine      Int     @default(0)
  endLine        Int     @default(0)
  symbol         String?
  message        String
  explanation    String
  evidence       String?
  metrics        Json?
  recommendation String

  cwe            Json?
  cve            String?
  cvss           Float?

  createdAt DateTime @default(now())
}
